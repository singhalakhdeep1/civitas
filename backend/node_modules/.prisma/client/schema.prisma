generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  DONOR
  VOLUNTEER
  NONPROFIT_ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
  PENDING_VERIFICATION
}

enum OrganizationType {
  NONPROFIT_501C3
  CHARITY
  FOUNDATION
  SOCIAL_ENTERPRISE
  COMMUNITY_GROUP
  RELIGIOUS
  EDUCATIONAL
  ENVIRONMENTAL
  HEALTH
  ARTS_CULTURE
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignCategory {
  EDUCATION
  HEALTH
  ENVIRONMENT
  POVERTY
  ANIMALS
  ARTS
  COMMUNITY
  HUMAN_RIGHTS
  DISASTER_RELIEF
  CHILDREN
  ELDERLY
  HOUSING
  FOOD_SECURITY
}

enum DonationFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  PAYPAL
  CRYPTO
}

enum VolunteerStatus {
  OPEN
  FILLED
  CLOSED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum EventType {
  FUNDRAISER
  AWARENESS
  VOLUNTEER
  TRAINING
  COMMUNITY
  GALA
  AUCTION
  WALK_RUN
  VIRTUAL
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum TicketType {
  FREE
  PAID
  DONATION_BASED
}

enum RegistrationStatus {
  REGISTERED
  CHECKED_IN
  NO_SHOW
  CANCELLED
}

enum PetitionStatus {
  DRAFT
  ACTIVE
  SUCCESSFUL
  CLOSED
  REMOVED
}

enum PetitionTarget {
  GOVERNMENT
  CORPORATION
  ORGANIZATION
  INDIVIDUAL
}

enum ImpactCategory {
  PEOPLE_HELPED
  FUNDS_RAISED
  VOLUNTEER_HOURS
  MEALS_PROVIDED
  TREES_PLANTED
  ANIMALS_RESCUED
  HOMES_BUILT
  STUDENTS_EDUCATED
  HEALTHCARE_PROVIDED
  CLEAN_WATER_ACCESS
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum CommunicationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ============================================
// CORE USER MODELS
// ============================================

model User {
  id       String        @id @default(cuid())
  email    String        @unique
  password String?
  role     UserRole      @default(DONOR)
  status   AccountStatus @default(PENDING_VERIFICATION)

  // OAuth fields
  googleId   String? @unique
  facebookId String? @unique
  githubId   String? @unique

  emailVerified    Boolean   @default(false)
  emailVerifiedAt  DateTime?
  phoneNumber      String?
  phoneVerified    Boolean   @default(false)
  twoFactorEnabled Boolean   @default(false)

  lastLoginAt DateTime?
  lastLoginIp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  profile             Profile?
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]

  // Nonprofit relations
  nonprofitAdmin NonprofitAdmin?
  volunteering   VolunteerProfile?

  // Activity
  donations             Donation[]
  recurringDonations    RecurringDonation[]
  volunteerApplications VolunteerApplication[]
  volunteerHours        VolunteerHours[]
  eventRegistrations    EventRegistration[]
  petitionSignatures    PetitionSignature[]
  forumPosts            ForumPost[]
  forumComments         ForumComment[]

  // Notifications
  notifications      Notification[]
  communicationPrefs CommunicationPreference?

  @@index([email])
  @@index([role])
  @@map("users")
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String?
  lastName    String?
  displayName String?
  avatar      String?
  bio         String?

  // Contact
  address String?
  city    String?
  state   String?
  zipCode String?
  country String?

  // Social
  website  String?
  linkedin String?
  twitter  String?

  // Preferences
  isPublic           Boolean @default(true)
  showDonations      Boolean @default(false)
  showVolunteerHours Boolean @default(true)

  // Tax info (for receipts)
  taxId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model VerificationToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@map("verification_tokens")
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ============================================
// NONPROFIT ORGANIZATION MODELS
// ============================================

model Nonprofit {
  id String @id @default(cuid())

  // Basic info
  name String
  slug String           @unique
  ein  String?          @unique // Tax ID
  type OrganizationType

  // Contact
  email   String
  phone   String?
  website String?

  // Address
  address String
  city    String
  state   String
  zipCode String
  country String @default("USA")

  // Content
  mission     String
  description String
  logo        String?
  coverImage  String?
  videoUrl    String?

  // Verification
  verified           Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?

  // Tax exempt
  taxExempt    Boolean @default(false)
  taxExemptDoc String?

  // Stats
  totalDonations Float @default(0)
  donorCount     Int   @default(0)
  volunteerCount Int   @default(0)

  // Status
  status AccountStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  admins      NonprofitAdmin[]
  teamMembers TeamMember[]
  categories  NonprofitCategory[]
  socialMedia SocialMedia?

  campaigns        Campaign[]
  events           Event[]
  volunteerOpps    VolunteerOpportunity[]
  impactMetrics    ImpactMetric[]
  financialReports FinancialReport[]

  // Reviews
  reviews     NonprofitReview[]
  avgRating   Float             @default(0)
  reviewCount Int               @default(0)

  @@index([slug])
  @@index([verified])
  @@map("nonprofits")
}

model NonprofitAdmin {
  id          String @id @default(cuid())
  userId      String @unique
  nonprofitId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nonprofit Nonprofit @relation(fields: [nonprofitId], references: [id], onDelete: Cascade)

  isOwner     Boolean  @default(false)
  permissions String[] // Array of permission strings

  createdAt DateTime @default(now())

  @@map("nonprofit_admins")
}

model TeamMember {
  id          String    @id @default(cuid())
  nonprofitId String
  nonprofit   Nonprofit @relation(fields: [nonprofitId], references: [id], onDelete: Cascade)

  name   String
  title  String
  email  String?
  phone  String?
  bio    String?
  avatar String?

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

model NonprofitCategory {
  id          String    @id @default(cuid())
  nonprofitId String
  nonprofit   Nonprofit @relation(fields: [nonprofitId], references: [id], onDelete: Cascade)

  name String

  @@unique([nonprofitId, name])
  @@map("nonprofit_categories")
}

model SocialMedia {
  id          String    @id @default(cuid())
  nonprofitId String    @unique
  nonprofit   Nonprofit @relation(fields: [nonprofitId], references: [id], onDelete: Cascade)

  facebook  String?
  twitter   String?
  instagram String?
  linkedin  String?
  youtube   String?
  tiktok    String?

  @@map("social_media")
}

model NonprofitReview {
  id          String @id @default(cuid())
  nonprofitId String
  userId      String

  nonprofit Nonprofit @relation(fields: [nonprofitId], references: [id], onDelete: Cascade)

  rating  Int // 1-5
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nonprofitId, userId])
  @@map("nonprofit_reviews")
}

// ============================================
// CAMPAIGN MODELS (Fundraising)
// ============================================

model Campaign {
  id          String    @id @default(cuid())
  nonprofitId String
  nonprofit   Nonprofit @relation(fields: [nonprofitId], references: [id], onDelete: Cascade)

  // Basic info
  title       String
  slug        String  @unique
  description String
  story       String?

  // Images/Video
  coverImage String?
  videoUrl   String?
  images     String[] // Array of image URLs

  // Goals
  goalAmount Float
  currency   String           @default("USD")
  category   CampaignCategory

  // Dates
  startDate DateTime
  endDate   DateTime?

  // Status
  status   CampaignStatus @default(DRAFT)
  featured Boolean        @default(false)

  // Stats
  currentAmount Float @default(0)
  donorCount    Int   @default(0)
  shareCount    Int   @default(0)
  viewCount     Int   @default(0)

  // Matching
  matchingEnabled Boolean @default(false)
  matchingAmount  Float?
  matchingSponsor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  milestones CampaignMilestone[]
  updates    CampaignUpdate[]
  donations  Donation[]
  tags       CampaignTag[]

  @@index([slug])
  @@index([status])
  @@index([category])
  @@map("campaigns")
}

model CampaignMilestone {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title     String
  amount    Float
  reached   Boolean   @default(false)
  reachedAt DateTime?

  order Int

  @@map("campaign_milestones")
}

model CampaignUpdate {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title   String
  content String
  images  String[]

  createdAt DateTime @default(now())

  @@map("campaign_updates")
}

model CampaignTag {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name String

  @@unique([campaignId, name])
  @@map("campaign_tags")
}

// ============================================
// DONATION MODELS
// ============================================

model Donation {
  id String @id @default(cuid())

  // Donor
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Target
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  nonprofitId String // Always required

  // Amount
  amount    Float
  currency  String            @default("USD")
  frequency DonationFrequency @default(ONE_TIME)

  // Payment
  stripePaymentId String?
  paymentMethod   PaymentMethod
  status          DonationStatus @default(PENDING)

  // Anonymous
  anonymous Boolean @default(false)

  // Dedic dedication
  dedicatedTo       String?
  dedicationMessage String?

  // Message
  message String?

  // Tax receipt
  taxReceiptIssued Boolean @default(false)
  receiptNumber    String?

  // Fees
  platformFee   Float @default(0)
  processingFee Float @default(0)
  netAmount     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([campaignId])
  @@index([status])
  @@map("donations")
}

model RecurringDonation {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nonprofitId String
  campaignId  String?

  amount    Float
  currency  String            @default("USD")
  frequency DonationFrequency @default(MONTHLY)

  // Stripe subscription
  stripeSubscriptionId String?
  stripeCustomerId     String?

  // Status
  active          Boolean   @default(true)
  nextBillingDate DateTime?

  // Stats
  totalDonated  Float @default(0)
  donationCount Int   @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  @@index([userId])
  @@index([active])
  @@map("recurring_donations")
}

model PaymentMethodRecord {
  id String @id @default(cuid())

  userId String

  // Stripe
  stripePaymentMethodId String?

  type        PaymentMethod
  last4       String?
  brand       String?
  expiryMonth Int?
  expiryYear  Int?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("payment_methods")
}

// ============================================
// VOLUNTEERING MODELS
// ============================================

model VolunteerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Info
  bio          String?
  skills       String[] // Array of skills
  interests    String[] // Array of interests
  availability String?

  // Emergency contact
  emergencyContactName  String?
  emergencyContactPhone String?

  // Background check
  backgroundCheckStatus VerificationStatus @default(PENDING)
  backgroundCheckDate   DateTime?

  // Stats
  totalHours             Float @default(0)
  opportunitiesCompleted Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  applications VolunteerApplication[]
  hours        VolunteerHours[]
  certificates VolunteerCertificate[]

  @@map("volunteer_profiles")
}

model VolunteerOpportunity {
  id          String    @id @default(cuid())
  nonprofitId String
  nonprofit   Nonprofit @relation(fields: [nonprofitId], references: [id], onDelete: Cascade)

  title        String
  description  String
  requirements String?

  // Details
  category     String
  skillsNeeded String[]

  // Location
  isRemote Boolean @default(false)
  location String?
  address  String?
  city     String?
  state    String?
  zipCode  String?

  // Timing
  startDate    DateTime
  endDate      DateTime?
  hoursPerWeek Int?
  totalSpots   Int
  filledSpots  Int       @default(0)

  // Status
  status VolunteerStatus @default(OPEN)

  // Requirements
  backgroundCheckRequired Boolean @default(false)
  minAge                  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  applications VolunteerApplication[]
  hours        VolunteerHours[]

  @@index([status])
  @@index([category])
  @@map("volunteer_opportunities")
}

model VolunteerApplication {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  opportunityId String
  opportunity   VolunteerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  volunteerProfileId String?
  volunteerProfile   VolunteerProfile? @relation(fields: [volunteerProfileId], references: [id])

  // Application
  message String?
  resume  String? // File URL

  status ApplicationStatus @default(PENDING)

  // Response
  responseMessage String?
  respondedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, opportunityId])
  @@map("volunteer_applications")
}

model VolunteerHours {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  opportunityId String?
  opportunity   VolunteerOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  volunteerProfileId String?
  volunteerProfile   VolunteerProfile? @relation(fields: [volunteerProfileId], references: [id])

  // Hours
  date        DateTime
  hours       Float
  description String?

  // Verification
  verified   Boolean   @default(false)
  verifiedBy String?
  verifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([date])
  @@map("volunteer_hours")
}

model VolunteerCertificate {
  id String @id @default(cuid())

  userId  String
  profile VolunteerProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String
  totalHours  Float

  certificateUrl   String?
  verificationCode String  @unique

  issuedAt DateTime @default(now())

  @@map("volunteer_certificates")
}

// ============================================
// EVENT MODELS
// ============================================

model Event {
  id          String    @id @default(cuid())
  nonprofitId String
  nonprofit   Nonprofit @relation(fields: [nonprofitId], references: [id], onDelete: Cascade)

  // Basic info
  title       String
  slug        String @unique
  description String

  type   EventType
  status EventStatus @default(DRAFT)

  // Images
  coverImage String?
  images     String[]

  // Location
  isVirtual   Boolean @default(false)
  virtualLink String? // Zoom, etc.
  venue       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?

  // Dates
  startDate DateTime
  endDate   DateTime
  timezone  String   @default("America/New_York")

  // Capacity
  capacity        Int?
  registeredCount Int  @default(0)
  checkedInCount  Int  @default(0)

  // Registration
  registrationRequired Boolean   @default(true)
  registrationDeadline DateTime?

  // Fees
  isFree Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tickets       EventTicket[]
  registrations EventRegistration[]

  @@index([slug])
  @@index([status])
  @@index([startDate])
  @@map("events")
}

model EventTicket {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name        String
  description String?
  type        TicketType

  price    Float?
  quantity Int?
  sold     Int    @default(0)

  salesStart DateTime?
  salesEnd   DateTime?

  @@map("event_tickets")
}

model EventRegistration {
  id String @id @default(cuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ticketId String?

  // Guest info
  firstName String
  lastName  String
  email     String
  phone     String?

  // Status
  status RegistrationStatus @default(REGISTERED)

  // Check-in
  checkedIn   Boolean   @default(false)
  checkedInAt DateTime?

  // Payment
  amountPaid      Float?
  stripePaymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@map("event_registrations")
}

// ============================================
// PETITION MODELS (Civic Actions)
// ============================================

model Petition {
  id String @id @default(cuid())

  creatorId String

  title       String
  slug        String @unique
  description String

  // Target
  target      PetitionTarget
  targetName  String
  targetEmail String?

  // Goals
  signatureGoal     Int
  currentSignatures Int @default(0)

  // Status
  status PetitionStatus @default(DRAFT)

  // Content
  coverImage String?
  videoUrl   String?

  // Dates
  startDate DateTime  @default(now())
  endDate   DateTime?

  // Victory
  successful   Boolean   @default(false)
  successStory String?
  successDate  DateTime?

  // Stats
  shareCount Int @default(0)
  viewCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  signatures PetitionSignature[]
  updates    PetitionUpdate[]

  @@index([slug])
  @@index([status])
  @@map("petitions")
}

model PetitionSignature {
  id String @id @default(cuid())

  petitionId String
  petition   Petition @relation(fields: [petitionId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Signer info (for non-users)
  firstName String
  lastName  String
  email     String
  zipCode   String?
  country   String?

  // Comment
  comment String?

  // Privacy
  showPublicly Boolean @default(true)

  signedAt DateTime @default(now())

  @@unique([petitionId, email])
  @@index([petitionId])
  @@map("petition_signatures")
}

model PetitionUpdate {
  id         String   @id @default(cuid())
  petitionId String
  petition   Petition @relation(fields: [petitionId], references: [id], onDelete: Cascade)

  title   String
  content String

  createdAt DateTime @default(now())

  @@map("petition_updates")
}

// ============================================
// IMPACT TRACKING MODELS
// ============================================

model ImpactMetric {
  id          String    @id @default(cuid())
  nonprofitId String
  nonprofit   Nonprofit @relation(fields: [nonprofitId], references: [id], onDelete: Cascade)

  category    ImpactCategory
  name        String
  description String?

  // Metric value
  currentValue Float
  targetValue  Float?
  unit         String

  // Period
  startDate DateTime
  endDate   DateTime?

  // Visibility
  isPublic Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  stories ImpactStory[]

  @@map("impact_metrics")
}

model ImpactStory {
  id       String        @id @default(cuid())
  metricId String?
  metric   ImpactMetric? @relation(fields: [metricId], references: [id], onDelete: SetNull)

  title String
  story String

  // Media
  images   String[]
  videoUrl String?

  // Beneficiary
  beneficiaryName  String?
  beneficiaryPhoto String?

  // Dates
  date DateTime

  createdAt DateTime @default(now())

  @@map("impact_stories")
}

model FinancialReport {
  id          String    @id @default(cuid())
  nonprofitId String
  nonprofit   Nonprofit @relation(fields: [nonprofitId], references: [id], onDelete: Cascade)

  year    Int
  quarter Int?

  // Revenue
  donations    Float
  grants       Float
  other        Float
  totalRevenue Float

  // Expenses
  programs      Float
  fundraising   Float
  admin         Float
  totalExpenses Float

  // File
  reportUrl String?

  createdAt DateTime @default(now())

  @@unique([nonprofitId, year, quarter])
  @@map("financial_reports")
}

// ============================================
// FORUM/COMMUNITY MODELS
// ============================================

model Forum {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String?
  icon        String?

  order Int @default(0)

  // Stats
  threadCount Int @default(0)
  postCount   Int @default(0)

  createdAt DateTime @default(now())

  // Relations
  threads ForumThread[]

  @@map("forums")
}

model ForumThread {
  id      String @id @default(cuid())
  forumId String
  forum   Forum  @relation(fields: [forumId], references: [id], onDelete: Cascade)

  authorId String

  title   String
  content String

  // Status
  pinned Boolean @default(false)
  locked Boolean @default(false)

  // Stats
  views     Int @default(0)
  postCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  posts ForumPost[]

  @@index([forumId])
  @@map("forum_threads")
}

model ForumPost {
  id       String      @id @default(cuid())
  threadId String
  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String

  // Moderation
  edited   Boolean   @default(false)
  editedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  comments ForumComment[]

  @@index([threadId])
  @@index([authorId])
  @@map("forum_posts")
}

model ForumComment {
  id     String    @id @default(cuid())
  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String

  createdAt DateTime @default(now())

  @@index([postId])
  @@map("forum_comments")
}

// ============================================
// COMMUNICATION MODELS
// ============================================

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  // Link
  linkUrl String?

  // Status
  read   Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model EmailCampaign {
  id String @id @default(cuid())

  nonprofitId String

  // Content
  subject String
  content String

  // Sending
  status      String // DRAFT, SCHEDULED, SENT
  scheduledAt DateTime?
  sentAt      DateTime?

  // Recipients
  recipientCount Int @default(0)
  openCount      Int @default(0)
  clickCount     Int @default(0)

  createdAt DateTime @default(now())

  @@map("email_campaigns")
}

model CommunicationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Email preferences
  emailDonationReceipts Boolean @default(true)
  emailCampaignUpdates  Boolean @default(true)
  emailEventReminders   Boolean @default(true)
  emailNewsletter       Boolean @default(true)
  emailVolunteerAlerts  Boolean @default(true)

  // SMS preferences
  smsEnabled        Boolean @default(false)
  smsEventReminders Boolean @default(false)
  smsUrgentAlerts   Boolean @default(false)

  // Push preferences
  pushEnabled         Boolean @default(true)
  pushDonationConfirm Boolean @default(true)
  pushEventReminders  Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("communication_preferences")
}

// ============================================
// ANALYTICS MODELS
// ============================================

model DonorAnalytics {
  id String @id @default(cuid())

  userId      String
  nonprofitId String?

  // Donation stats
  totalDonated    Float
  donationCount   Int
  avgDonation     Float
  firstDonationAt DateTime
  lastDonationAt  DateTime

  // Behavior
  recurringDonor    Boolean
  donationFrequency String?

  // Engagement
  eventAttendance Int
  volunteerHours  Float

  // Retention
  lifeTimeValue  Float
  retentionScore Float?
  churnRisk      String? // LOW, MEDIUM, HIGH

  updatedAt DateTime @updatedAt

  @@unique([userId, nonprofitId])
  @@map("donor_analytics")
}

model CampaignAnalytics {
  id         String @id @default(cuid())
  campaignId String @unique

  // Traffic
  views          Int
  uniqueVisitors Int

  // Conversion
  conversionRate Float
  avgDonation    Float

  // Social
  shares      Int
  socialReach Int?

  // Sources
  directTraffic Int
  socialTraffic Int
  emailTraffic  Int
  searchTraffic Int

  updatedAt DateTime @updatedAt

  @@map("campaign_analytics")
}

model NonprofitAnalytics {
  id          String @id @default(cuid())
  nonprofitId String @unique

  // Revenue
  totalRevenue     Float
  monthlyRecurring Float
  avgDonationSize  Float

  // Donors
  activeDonors   Int
  newDonors      Int
  retainedDonors Int
  churnedDonors  Int

  // Volunteers
  activeVolunteers Int
  volunteerHours   Float

  // Engagement
  eventAttendance Int
  forumPosts      Int
  campaignShares  Int

  // Period
  period String // YYYY-MM

  createdAt DateTime @default(now())

  @@unique([nonprofitId, period])
  @@map("nonprofit_analytics")
}
